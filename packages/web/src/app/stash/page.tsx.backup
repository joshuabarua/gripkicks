// Condition options
const conditions = [
  { value: 'New', label: 'New - Never worn' },
  { value: 'Like New', label: 'Like New - Worn once or twice' },
  { value: 'Good', label: 'Good - Light wear, good condition' },
  { value: 'Fair', label: 'Fair - Moderate wear, still functional' },
  { value: 'Worn', label: 'Worn - Heavy wear but usable' },
  { value: 'Retired', label: 'Retired - No longer in use' },
];

// Zod schema for form validation
const editFormSchema = z.object({
  size: z.string().optional(),
  purchaseDate: z.string().optional(),
  condition: z.string().optional(),
  notes: z.string().optional(),
  showNotes: z.boolean(),
  // Comfort ranking fields - initialize as undefined instead of empty strings
  comfortScore: z.coerce.number().min(1).max(10).optional(),
  performanceRating: z.coerce.number().min(1).max(10).optional(),
  durabilityRating: z.coerce.number().min(1).max(10).optional(),
});

interface CloudShoeProps {
  shoe: UserShoe;
  onClick: () => void;
  index: number;
}

function CloudShoe({ shoe, onClick, index }: CloudShoeProps) {
  return (
    <motion.div
      className="absolute cursor-pointer group"
      style={{
        left: `${20 + (index * 15) % 60}px`,
        top: `${20 + (index * 10) % 60}px`,
        animation: `float ${5 + index % 3}s ease-in-out infinite`,
        animationDelay: `${index * 0.5}s`,
      }}
      onClick={onClick}
      whileHover={{ scale: 1.1, rotate: 5 }}
      whileTap={{ scale: 0.95 }}
    >
      {/* Shoe content */}
      <div className="relative z-10 flex flex-col items-center justify-center w-48 h-48">
        <div className="relative w-36 h-36 mb-2">
          {/* White circular background */}
          <div className="absolute inset-0 bg-white rounded-full shadow-lg"></div>
          {/* Shoe image with rounded corners */}
          <div className="absolute inset-2 overflow-hidden rounded-3xl">
            <ShoeImage
              brand={shoe.shoe.brand}
              shoeName={shoe.shoe.name}
              imageUrl={shoe.shoe.imageUrl}
              className="w-full h-full object-cover"
              transformation={[
                {
                  height: 225,
                  width: 225,
                  format: "auto",
                  quality: 90
                }
              ]}
            />
          </div>
        </div>
        {/* Shoe name - show on hover with cloud font and wavy line */}
        <motion.div 
          className="absolute -bottom-8 left-1/2 transform -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-all duration-300"
          initial={{ opacity: 0, y: 5 }}
          whileHover={{ opacity: 1, y: 0 }}
          onMouseEnter={(e) => {
            e.currentTarget.style.opacity = '1';
          }}
        >
          {/* Wavy line connecting to text */}
          <svg className="absolute -top-2 left-1/2 transform -translate-x-1/2" width="60" height="10" viewBox="0 0 60 10">
            <path d="M0,5 Q15,0 30,5 T60,5" stroke="white" strokeWidth="1.5" fill="none" />
          </svg>
          <div className="bg-black/60 backdrop-blur-sm px-3 py-2 rounded-lg">
            <p className="text-sm text-white text-center font-so-cloudy uppercase whitespace-nowrap">
              {shoe.shoe.name}
            </p>
            <p className="text-xs text-white/80 text-center">
              {shoe.shoe.brand}
            </p>
          </div>
        </motion.div>
      </div>
    </motion.div>
  );
}

export default function ShoeSanctuaryPage() {
  const { data: session, isPending: sessionLoading } = useSession();
  const toast = useToast();
  const [userShoes, setUserShoes] = useState<UserShoe[]>([]);
  const [selectedShoe, setSelectedShoe] = useState<UserShoe | null>(null);
  const [isAddDialogOpen, setIsAddDialogOpen] = useState(false);
  const [searchQuery, setSearchQuery] = useState('');
  const [editingShoe, setEditingShoe] = useState<UserShoe | null>(null);
  const [editForm, setEditForm] = useState({
    size: '',
    purchaseDate: '',
    condition: '',
    notes: '',
    showNotes: false,
    // Comfort ranking fields - initialize as undefined instead of empty strings
    comfortScore: undefined as number | undefined,
    performanceRating: undefined as number | undefined,
    durabilityRating: undefined as number | undefined,
  });

  // Fetch all shoes from Convex
  const shoesData = useQuery(api.shoes.list);
  const allShoes = useMemo(() => shoesData ?? [], [shoesData]);

  const fetchUserStash = useCallback(async () => {
    try {
      const response = await fetchApi<GetStashResponse>('/api/v1/stash');
      if (response.success && response.data) {
        setUserShoes(response.data);
      } else {
        toast.addToast(response.error || 'Failed to load your shoe collection', 'error');
      }
    } catch (error) {
      console.error('Failed to fetch user stash:', error);
      toast.addToast('Failed to load your shoe collection', 'error');
    }
  }, [toast]);

  // Fetch user's stash from Hono API
  useEffect(() => {
    if (session?.user) {
      fetchUserStash();
    }
  }, [session, fetchUserStash]);

  // Search for shoes
  const searchResults = useMemo(() => {
    if (searchQuery.length > 2) {
      return allShoes.filter(shoe =>
        shoe.name.toLowerCase().includes(searchQuery.toLowerCase()) ||
        shoe.brand.toLowerCase().includes(searchQuery.toLowerCase())
      );
    }
    return [];
  }, [searchQuery, allShoes]);

  const addShoeToSanctuary = async (shoeId: string) => {
    try {
      const response = await fetchApi('/api/v1/stash', {
        method: 'POST',
        body: JSON.stringify({ shoeId }),
      });
      
      if (response.success) {
        await fetchUserStash();
        setIsAddDialogOpen(false);
        setSearchQuery('');
        toast.addToast('Shoe added to your sanctuary!', 'success');
      } else {
        toast.addToast(response.error || 'Failed to add shoe', 'error');
      }
    } catch (error) {
      console.error('Failed to add shoe:', error);
      toast.addToast('Failed to add shoe to sanctuary', 'error');
    }
  };

  const updateShoeStats = async () => {
    if (!editingShoe) return;

    // Validate form data with Zod
    const validationResult = editFormSchema.safeParse(editForm);
    if (!validationResult.success) {
      const errors = validationResult.error.flatten();
      console.error('Validation errors:', errors);
      toast.addToast('Please check your input values', 'error');
      return;
    }

    try {
      const response = await fetchApi(`/api/v1/stash/${editingShoe._id}`, {
        method: 'PUT',
        body: JSON.stringify(editForm),
      });
      
      if (response.success) {
        await fetchUserStash();
        setEditingShoe(null);
        setSelectedShoe(null);
        toast.addToast('Shoe updated successfully!', 'success');
      } else {
        toast.addToast(response.error || 'Failed to update shoe', 'error');
      }
    } catch (error) {
      console.error('Failed to update shoe:', error);
      toast.addToast('Failed to update shoe', 'error');
    }
  };

  const removeShoe = async (shoeId: string) => {
    try {
      const response = await fetchApi(`/api/v1/stash/${shoeId}`, { method: 'DELETE' });
      
      if (response.success) {
        await fetchUserStash();
        setSelectedShoe(null);
        toast.addToast('Shoe removed from your sanctuary', 'success');
      } else {
        toast.addToast(response.error || 'Failed to remove shoe', 'error');
      }
    } catch (error) {
      console.error('Failed to remove shoe:', error);
      toast.addToast('Failed to remove shoe', 'error');
    }
  };

  const openEditDialog = (shoe: UserShoe) => {
    setEditingShoe(shoe);
    setEditForm({
      size: shoe.size || '',
      purchaseDate: shoe.purchaseDate || '',
      condition: shoe.condition || '',
      notes: shoe.notes || '',
      showNotes: !!shoe.notes,
      // Keep as numbers
      comfortScore: shoe.comfortScore,
      performanceRating: shoe.performanceRating,
      durabilityRating: shoe.durabilityRating,
    });
  };

  if (sessionLoading) {
    return (
      <div className="flex min-h-svh w-full items-center justify-center">
        <div className="animate-spin rounded-full h-8 w-8 border-b-2 border-white"></div>
      </div>
    );
  }

  if (!session?.user) {
    return (
      <div className="flex min-h-svh w-full items-center justify-center p-6">
        <div className="text-center text-white">
          <h1 className="text-3xl font-bold mb-4 font-so-cloudy uppercase">Shoe Sanctuary</h1>
          <p>Please log in to view your shoe sanctuary</p>
        </div>
      </div>
    );
  }

  return (
    <div className="relative min-h-svh w-full overflow-hidden flex items-center justify-center">
      {/* Cloud background image */}
      <div 
        className="absolute inset-0 bg-cover bg-center bg-no-repeat"
        style={{ backgroundImage: 'url("/imgs/clouds/clouds 4.png")' }}
      />
      
      {/* Floating clouds animation - between background and content */}
      <div className="absolute inset-0 overflow-hidden pointer-events-none z-0">
        {/* Top quadrant */}
        <div className="absolute top-10 animate-cloud-left-to-right-slow">
          <img src="/imgs/clouds/cloud1.png" alt="Cloud" className="w-96 h-auto opacity-95" style={{ maxHeight: '400px' }} />
        </div>
        <div className="absolute top-32 animate-cloud-right-to-left-medium" style={{ animationDelay: '8s' }}>
          <img src="/imgs/clouds/cloud3.png" alt="Cloud" className="w-80 h-auto opacity-90" style={{ maxHeight: '400px' }} />
        </div>
        <div className="absolute top-16 animate-cloud-left-to-right-fast" style={{ animationDelay: '16s' }}>
          <img src="/imgs/clouds/cloud2.png" alt="Cloud" className="w-64 h-auto opacity-85" style={{ maxHeight: '400px' }} />
        </div>
        
        {/* Middle quadrant */}
        <div className="absolute top-1/3 animate-cloud-right-to-left-slow" style={{ animationDelay: '4s' }}>
          <img src="/imgs/clouds/cloud2.png" alt="Cloud" className="w-[400px] h-auto opacity-95" />
        </div>
        <div className="absolute top-2/5 animate-cloud-left-to-right-medium" style={{ animationDelay: '12s' }}>
          <img src="/imgs/clouds/cloud4.png" alt="Cloud" className="w-72 h-auto opacity-90" style={{ maxHeight: '400px' }} />
        </div>
        <div className="absolute top-1/2 animate-cloud-right-to-left-fast" style={{ animationDelay: '20s' }}>
          <img src="/imgs/clouds/cloud5.png" alt="Cloud" className="w-56 h-auto opacity-85" style={{ maxHeight: '400px' }} />
        </div>
        
        {/* Bottom quadrant with some cut-off clouds */}
        <div className="absolute bottom-0 animate-cloud-left-to-right-medium" style={{ animationDelay: '6s' }}>
          <img src="/imgs/clouds/cloud3.png" alt="Cloud" className="w-80 h-auto opacity-90" style={{ maxHeight: '400px' }} />
        </div>
        <div className="absolute bottom-0 animate-cloud-right-to-left-slow" style={{ animationDelay: '14s' }}>
          <img src="/imgs/clouds/cloud4.png" alt="Cloud" className="w-[350px] h-auto opacity-95" style={{ maxHeight: '400px' }} />
        </div>
        <div className="absolute bottom-10 animate-cloud-left-to-right-fast" style={{ animationDelay: '18s' }}>
          <img src="/imgs/clouds/cloud5.png" alt="Cloud" className="w-60 h-auto opacity-85" style={{ maxHeight: '400px' }} />
        </div>
      </div>
      
      {/* Overlay for better text visibility */}
      <div className="absolute inset-0 bg-gradient-to-b from-blue-400/20 via-blue-300/20 to-blue-200/20" />
      
      {/* Add global styles */}
      <style jsx global>{`
        @keyframes float {
          0%, 100% {
            transform: translateY(0px);
          }
          50% {
            transform: translateY(-20px);
          }
        }
        
        @keyframes cloud-left-to-right {
          0% {
            transform: translateX(-400px);
          }
          100% {
            transform: translateX(calc(100vw + 400px));
          }
        }
        
        @keyframes cloud-right-to-left {
          0% {
            transform: translateX(calc(100vw + 400px));
          }
          100% {
            transform: translateX(-400px);
          }
        }
        
        .animate-cloud-left-to-right-slow {
          animation: cloud-left-to-right 60s linear infinite;
        }
        
        .animate-cloud-left-to-right-medium {
          animation: cloud-left-to-right 45s linear infinite;
        }
        
        .animate-cloud-left-to-right-fast {
          animation: cloud-left-to-right 30s linear infinite;
        }
        
        .animate-cloud-right-to-left-slow {
          animation: cloud-right-to-left 65s linear infinite;
        }
        
        .animate-cloud-right-to-left-medium {
          animation: cloud-right-to-left 50s linear infinite;
        }
        
        .animate-cloud-right-to-left-fast {
          animation: cloud-right-to-left 35s linear infinite;
        }
      `}</style>

      {/* Header */}
      <div className="absolute top-0 left-0 right-0 z-20 p-6" style={{ paddingTop: '120px' }}>
        <div className="flex justify-center items-center">
          <div className="text-center">
            <h1 className="text-4xl font-bold text-white mb-0 font-so-cloudy uppercase" style={{ fontSize: '68px', position: 'relative', display: 'inline-block' }}>
              Shoe Sanctuary
              <svg style={{ position: 'absolute', bottom: '-10px', left: 0, width: '100%', height: '10px' }} viewBox="0 0 200 10" preserveAspectRatio="none">
                <path d="M0,5 Q25,0 50,5 T100,5 T150,5 T200,5" stroke="white" strokeWidth="2" fill="none" />
              </svg>
            </h1>
          </div>
          <div className="absolute right-6">
            <Dialog open={isAddDialogOpen} onOpenChange={setIsAddDialogOpen}>
              <DialogTrigger asChild>
                <Button className="bg-white/20 backdrop-blur-sm hover:bg-white/30 text-white border border-white/30">
                  <Plus className="w-4 h-4 mr-2" />
                  Add Shoe
                </Button>
              </DialogTrigger>
              <DialogContent className="bg-gray-900/95 backdrop-blur-sm text-gray-100 border border-gray-700 max-w-md">
                <DialogHeader>
                  <DialogTitle className="text-gray-100 font-so-cloudy uppercase">Add New Shoe</DialogTitle>
                  <DialogDescription className="text-gray-400">
                    Search for climbing shoes to add to your sanctuary
                  </DialogDescription>
                </DialogHeader>
                <div className="space-y-4">
                  <div className="relative">
                    <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-gray-400" />
                    <Input
                      placeholder="Search by shoe name or brand..."
                      value={searchQuery}
                      onChange={(e) => setSearchQuery(e.target.value)}
                      className="pl-10 bg-gray-800/50 text-gray-100 placeholder:text-gray-500 border-gray-600 focus:border-gray-500"
                    />
                  </div>
                  
                  <div className="max-h-60 overflow-y-auto space-y-2">
                    {searchResults.map((shoe) => (
                      <div
                        key={shoe._id}
                        className="flex items-center justify-between p-3 rounded-lg bg-gray-800/50 hover:bg-gray-700/50 cursor-pointer transition-colors border border-gray-700"
                        onClick={() => addShoeToSanctuary(shoe._id)}
                      >
                        <div>
                          <p className="font-medium">{shoe.name}</p>
                          <p className="text-sm text-gray-400">{shoe.brand}</p>
                        </div>
                        <Plus className="w-5 h-5" />
                      </div>
                    ))}
                  </div>
                  
                  {searchQuery.length > 2 && searchResults.length === 0 && (
                    <p className="text-center text-gray-400 py-4">
                      No shoes found. Try searching for climbing shoe brands like &quot;La Sportiva&quot;, &quot;Scarpa&quot;, or &quot;Five Ten&quot;.
                    </p>
                  )}
                </div>
              </DialogContent>
            </Dialog>
          </div>
        </div>
      </div>

      {/* Floating shoes - centered grouped by brand */}
      <div className="relative z-10 w-full h-full flex items-center justify-center">
        <div className="relative w-full max-w-6xl h-[600px] flex items-center justify-center">
          <div className="flex flex-wrap justify-center gap-8">
            {Object.entries(
              userShoes.reduce((acc: Record<string, UserShoe[]>, shoe: UserShoe) => {
                const brand = shoe.shoe.brand;
                if (!acc[brand]) acc[brand] = [];
                acc[brand].push(shoe);
                return acc;
              }, {} as Record<string, UserShoe[]>)
            ).map(([brand, shoes]: [string, UserShoe[]], brandIndex: number) => (
              <div key={brand} className="relative">
                <p className="text-white/60 text-xs font-so-cloudy uppercase mb-2 text-center">{brand}</p>
                <div className="relative w-48 h-48">
                  {shoes.map((shoe: UserShoe, index: number) => (
                    <CloudShoe
                      key={shoe._id}
                      shoe={shoe}
                      onClick={() => setSelectedShoe(shoe)}
                      index={index}
                    />
                  ))}
                </div>
              </div>
            ))}
          
          {userShoes.length === 0 && (
            <div className="absolute inset-0 flex flex-col items-center justify-center text-white/60">
              <Footprints className="w-16 h-16 mb-4" />
              <p className="text-xl">Your sanctuary is empty</p>
              <p className="text-sm">Click &quot;Add Shoe&quot; to start your collection.</p>
            </div>
          )}
        </div>
      </div>

      {/* Shoe detail dialog */}
      <AnimatePresence>
        {selectedShoe && !editingShoe && (
          <Dialog open={!!selectedShoe} onOpenChange={() => setSelectedShoe(null)}>
            <DialogContent className="bg-gray-900/95 backdrop-blur-sm text-gray-100 border border-gray-700 max-w-md">
              <DialogHeader>
                <div className="flex justify-between items-start">
                  <div>
                    <DialogTitle className="text-xl text-gray-100 font-so-cloudy uppercase">{selectedShoe.shoe.name}</DialogTitle>
                    <DialogDescription className="text-gray-400">{selectedShoe.shoe.brand}</DialogDescription>
                  </div>
                  <Button
                    variant="ghost"
                    size="sm"
                    onClick={() => openEditDialog(selectedShoe)}
                  >
                    <Edit2 className="w-4 h-4" />
                  </Button>
                </div>
              </DialogHeader>
              
              <div className="space-y-4">
                {selectedShoe.size && (
                  <div>
                    <Label className="text-sm text-gray-400">Size</Label>
                    <p className="font-medium">{selectedShoe.size}</p>
                  </div>
                )}
                
                {selectedShoe.purchaseDate && (
                  <div>
                    <Label className="text-sm text-gray-400">Purchase Date</Label>
                    <p className="font-medium">{selectedShoe.purchaseDate}</p>
                  </div>
                )}
                
                {selectedShoe.condition && (
                  <div>
                    <Label className="text-sm text-gray-400">Condition</Label>
                    <p className="font-medium">{selectedShoe.condition}</p>
                  </div>
                )}
                
                {selectedShoe.notes && (
                  <div>
                    <Label className="text-sm text-gray-400">Notes</Label>
                    <p className="font-medium">{selectedShoe.notes}</p>
                  </div>
                )}
                
                {/* Comfort Rankings Display */}
                {(selectedShoe.comfortScore || selectedShoe.performanceRating || selectedShoe.durabilityRating) && (
                  <div className="border-t border-gray-700 pt-4">
                    <h3 className="text-sm font-medium text-gray-300 mb-3">Comfort Rankings</h3>
                    <div className="grid grid-cols-3 gap-4">
                      {selectedShoe.comfortScore && (
                        <div>
                          <Label className="text-sm text-gray-400">Comfort</Label>
                          <div className="flex items-center">
                            <span className="font-medium mr-2">{selectedShoe.comfortScore}/10</span>
                            <div className="flex">
                              {[...Array(10)].map((_, i) => (
                                <span key={i} className={`text-xs ${i < (selectedShoe.comfortScore || 0) ? 'text-yellow-400' : 'text-gray-600'}`}>
                                  ★
                                </span>
                              ))}
                            </div>
                          </div>
                        </div>
                      )}
                      
                      {selectedShoe.performanceRating && (
                        <div>
                          <Label className="text-sm text-gray-400">Performance</Label>
                          <div className="flex items-center">
                            <span className="font-medium mr-2">{selectedShoe.performanceRating}/10</span>
                            <div className="flex">
                              {[...Array(10)].map((_, i) => (
                                <span key={i} className={`text-xs ${i < (selectedShoe.performanceRating || 0) ? 'text-blue-400' : 'text-gray-600'}`}>
                                  ★
                                </span>
                              ))}
                            </div>
                          </div>
                        </div>
                      )}
                      
                      {selectedShoe.durabilityRating && (
                        <div>
                          <Label className="text-sm text-gray-400">Durability</Label>
                          <div className="flex items-center">
                            <span className="font-medium mr-2">{selectedShoe.durabilityRating}/10</span>
                            <div className="flex">
                              {[...Array(10)].map((_, i) => (
                                <span key={i} className={`text-xs ${i < (selectedShoe.durabilityRating || 0) ? 'text-green-400' : 'text-gray-600'}`}>
                                  ★
                                </span>
                              ))}
                            </div>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                )}
                
                <div className="flex gap-2 pt-4">
                  <Button
                    variant="outline"
                    className="flex-1"
                    onClick={() => openEditDialog(selectedShoe)}
                  >
                    <Edit2 className="w-4 h-4 mr-2" />
                    Edit
                  </Button>
                  <Button
                    variant="destructive"
                    className="flex-1"
                    onClick={() => removeShoe(selectedShoe._id)}
                  >
                    <X className="w-4 h-4 mr-2" />
                    Remove
                  </Button>
                </div>
              </div>
            </DialogContent>
          </Dialog>
        )}
      </AnimatePresence>

      {/* Edit dialog */}
      <AnimatePresence>
        {editingShoe && (
          <Dialog open={!!editingShoe} onOpenChange={() => setEditingShoe(null)}>
            <DialogContent className="bg-gray-900/95 backdrop-blur-sm text-gray-100 border border-gray-700 max-w-lg">
              <DialogHeader>
                <DialogTitle className="text-gray-100 font-so-cloudy uppercase">Edit Shoe Stats</DialogTitle>
                <DialogDescription className="text-sm text-gray-400">
                  {editingShoe.shoe.name} - {editingShoe.shoe.brand}
                </DialogDescription>
              </DialogHeader>
              
              <div className="space-y-3">
                <div className="grid grid-cols-2 gap-3">
                  <div>
                    <Label htmlFor="size">Size</Label>
                    <select
                      id="size"
                      value={editForm.size}
                      onChange={(e) => setEditForm({ ...editForm, size: e.target.value })}
                      className="w-full px-3 py-2 bg-gray-800/50 text-gray-100 border border-gray-600 rounded-md focus:border-gray-500 focus:outline-none"
                    >
                      <option value="">Select size</option>
                      {shoeSizes.map((size, index) => {
                        if (size.separator) {
                          return (
                            <option key={`separator-${index}`} disabled className="text-gray-600">
                              {size.label}
                            </option>
                          );
                        }
                        return (
                          <option key={size.value} value={size.value}>
                            {size.label}
                          </option>
                        );
                      })}
                    </select>
                  </div>
                  
                  <div>
                    <Label htmlFor="condition">Condition</Label>
                    <select
                      id="condition"
                      value={editForm.condition}
                      onChange={(e) => setEditForm({ ...editForm, condition: e.target.value })}
                      className="w-full px-3 py-2 bg-gray-800/50 text-gray-100 border border-gray-600 rounded-md focus:border-gray-500 focus:outline-none"
                    >
                      <option value="">Select condition</option>
                      {conditions.map((condition) => (
                        <option key={condition.value} value={condition.value}>
                          {condition.label}
                        </option>
                      ))}
                    </select>
                  </div>
                  
                  <div>
                    <Label htmlFor="purchaseDate">Purchase Date</Label>
                    <Input
                      id="purchaseDate"
                      type="date"
                      value={editForm.purchaseDate}
                      onChange={(e) => setEditForm({ ...editForm, purchaseDate: e.target.value })}
                      className="bg-gray-800/50 text-gray-100 border-gray-600 focus:border-gray-500"
                    />
                  </div>
                  
                  <div>
                    <div className="flex items-center gap-2">
                      <Label htmlFor="comfortScore">Comfort (1-10)</Label>
                      <div className="group relative">
                        <HelpCircle className="w-4 h-4 text-gray-500 cursor-help" />
                        <div className="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-xs text-gray-300 rounded-md shadow-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                          How comfortable this shoe feels for your feet
                        </div>
                      </div>
                    </div>
                    <Input
                      id="comfortScore"
                      type="number"
                      min="1"
                      max="10"
                      value={editForm.comfortScore || ''}
                      onChange={(e) => setEditForm({ ...editForm, comfortScore: e.target.value ? parseInt(e.target.value) : undefined })}
                      placeholder="1-10"
                      className="bg-gray-800/50 text-gray-100 placeholder:text-gray-500 border-gray-600 focus:border-gray-500"
                    />
                  </div>
                  
                  <div className="relative">
                    <div className="flex items-center gap-2">
                      <Label htmlFor="performanceRating">Performance (1-10)</Label>
                      <div className="group relative">
                        <HelpCircle className="w-4 h-4 text-gray-500 cursor-help" />
                        <div className="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-xs text-gray-300 rounded-md shadow-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                          Rate how this shoe performs for your climbing style
                        </div>
                      </div>
                    </div>
                    <Input
                      id="performanceRating"
                      type="number"
                      min="1"
                      max="10"
                      value={editForm.performanceRating || ''}
                      onChange={(e) => setEditForm({ ...editForm, performanceRating: e.target.value ? parseInt(e.target.value) : undefined })}
                      placeholder="1-10"
                      className="bg-gray-800/50 text-gray-100 placeholder:text-gray-500 border-gray-600 focus:border-gray-500"
                    />
                  </div>
                  
                  <div>
                    <div className="flex items-center gap-2">
                      <Label htmlFor="durabilityRating">Durability (1-10)</Label>
                      <div className="group relative">
                        <HelpCircle className="w-4 h-4 text-gray-500 cursor-help" />
                        <div className="absolute bottom-full left-1/2 transform -translate-x-1/2 mb-2 px-3 py-2 bg-gray-800 text-xs text-gray-300 rounded-md shadow-lg opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap pointer-events-none">
                          How well this shoe holds up over time
                        </div>
                      </div>
                    </div>
                    <Input
                      id="durabilityRating"
                      type="number"
                      min="1"
                      max="10"
                      value={editForm.durabilityRating || ''}
                      onChange={(e) => setEditForm({ ...editForm, durabilityRating: e.target.value ? parseInt(e.target.value) : undefined })}
                      placeholder="1-10"
                      className="bg-gray-800/50 text-gray-100 placeholder:text-gray-500 border-gray-600 focus:border-gray-500"
                    />
                  </div>
                </div>
                
                {/* Collapsible Notes Section */}
                <div className="border-t border-gray-700">
                  <button
                    type="button"
                    onClick={() => setEditForm({ ...editForm, showNotes: !editForm.showNotes })}
                    className="flex items-center justify-between w-full py-2 text-sm text-gray-400 hover:text-gray-300 transition-colors"
                  >
                    <span>Additional Notes</span>
                    <ChevronDown className={`w-4 h-4 transition-transform ${editForm.showNotes ? 'rotate-180' : ''}`} />
                  </button>
                  {editForm.showNotes && (
                    <div className="pt-2">
                      <Textarea
                        id="notes"
                        value={editForm.notes}
                        onChange={(e) => setEditForm({ ...editForm, notes: e.target.value })}
                        placeholder="Any additional notes about this shoe..."
                        rows={2}
                        className="bg-gray-800/50 text-gray-100 placeholder:text-gray-500 border-gray-600 focus:border-gray-500 resize-none"
                      />
                    </div>
                  )}
                </div>
                
                <div className="flex gap-2 pt-4">
                  <Button
                    variant="outline"
                    className="flex-1"
                    onClick={() => setEditingShoe(null)}
                  >
                    Cancel
                  </Button>
                  <Button
                    className="flex-1"
                    onClick={updateShoeStats}
                  >
                    <Save className="w-4 h-4 mr-2" />
                    Save
                  </Button>
                </div>
              </div>
            </DialogContent>
          </Dialog>
        )}
      </AnimatePresence>

    </div>
  );
}
