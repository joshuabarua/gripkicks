NODE_ENV=production
BACKEND_PORT=3001
HOST=0.0.0.0
API_BASE=/api/v1

FRONTEND_URL=https://grip-kicks.com,https://www.grip-kicks.com
BETTER_AUTH_URL=https://api.grip-kicks.com
BETTER_AUTH_SECRET=<generate_strong_secret>

GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>

CONVEX_URL=https://<your-convex-prod>.convex.cloud

POLAR_ACCESS_TOKEN=<polar_access_token>
POLAR_WEBHOOK_SECRET=<polar_webhook_secret>
POLAR_PRODUCT_MONTHLY=<polar_product_id_monthly>
POLAR_PRODUCT_YEARLY=<polar_product_id_yearly>
POLAR_PRODUCT_LIFETIME=<polar_product_id_lifetime>

IMAGEKIT_PRIVATE_KEY=<imagekit_private_key>
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_imagekit_id>
