NODE_ENV=production
PORT=3001
BACKEND_PORT=3001
HOST=0.0.0.0
API_BASE=/api/v1

FRONTEND_URL=https://grip-kicks.com,https://www.grip-kicks.com
BETTER_AUTH_URL=https://api.grip-kicks.com
BETTER_AUTH_SECRET=<generate_strong_secret>

GOOGLE_CLIENT_ID=<google_client_id>
GOOGLE_CLIENT_SECRET=<google_client_secret>

CONVEX_URL=https://<your-convex-prod>.convex.cloud
CONVEX_SERVICE_TOKEN=<generate_strong_service_token>

IMAGEKIT_PRIVATE_KEY=<imagekit_private_key>
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<your_imagekit_id>

# Optional API rate limiting (per IP)
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=120
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_ACCOUNT_WINDOW_MS=60000
RATE_LIMIT_ACCOUNT_MAX=10
RATE_LIMIT_CHECKOUT_WINDOW_MS=60000
RATE_LIMIT_CHECKOUT_MAX=12
RATE_LIMIT_UPLOAD_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX=20
