{
  "name": "backend-api",
  "version": "1.0.0",
  "main": "dist/src/main.js",
  "scripts": {
    "start": "node dist/src/main.js",
    "build": "tsc",
    "dev": "cross-env NODE_ENV=production ts-node-dev -r tsconfig-paths/register --respawn --transpile-only src/main.ts",
    "dev:ngrok": "concurrently \"npm run dev\" \"ngrok http 3001 --log=stdout\""
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "@types/jsonwebtoken": "^9.0.10",
    "better-auth": "^1.4.17",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "hono": "^4.8.0",
    "jsonwebtoken": "^9.0.3",
    "neverthrow": "^8.2.0"
  },
  "devDependencies": {
    "@types/jsdom": "^27",
    "@types/node": "^25.1.0",
    "concurrently": "^9.2.1",
    "jsdom": "^27.4.0",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
