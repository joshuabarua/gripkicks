generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shoe {
  id                 String            @id @default(uuid())
  name               String
  brand              String
  imageUrl           String?
  aggressiveness     String
  stiffness          String
  climbingDiscipline String
  volume             String
  rubberTechnologyId String?
  comfortRankings    ComfortRanking[]
  footShapeCompat    FootShapeCompat[]
  rubberTechnology   RubberTechnology? @relation(fields: [rubberTechnologyId], references: [id])
}

model RubberTechnology {
  id         String @id @default(uuid())
  brand      String
  compound   String
  stickiness String
  durability String
  shoes      Shoe[]

  @@unique([brand, compound])
}

model ComfortRanking {
  id        String    @id @default(uuid())
  shoeId    String
  footShape FootShape
  volume    String
  score     Int
  shoe      Shoe      @relation(fields: [shoeId], references: [id])
}

model FootShapeCompat {
  id        String    @id @default(uuid())
  shoeId    String
  footShape FootShape
  shoe      Shoe      @relation(fields: [shoeId], references: [id])
}

model Account {
  id                 String    @id @map("id") @default(cuid())
  userId            String    @map("userId")
  type              String    @map("type")
  provider          String    @map("provider")
  providerAccountId String    @map("providerAccountId")
  refresh_token     String?   @map("refresh_token")
  access_token      String?   @map("access_token")
  expires_at        Int?      @map("expires_at")
  token_type        String?   @map("token_type")
  scope             String?   @map("scope")
  id_token          String?   @map("id_token")
  session_state     String?   @map("session_state")
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime  @default(now()) @map("createdAt")
  updatedAt         DateTime  @updatedAt @map("updatedAt")

  @@map("Account")
}

model Session {
  id           String   @id @map("id") @default(cuid())
  sessionToken String   @unique @map("sessionToken")
  userId       String   @map("userId")
  expires      DateTime @map("expires")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now()) @map("createdAt")
  updatedAt    DateTime @updatedAt @map("updatedAt")

  @@map("Session")
}

model User {
  id            String    @id @map("id") @default(cuid())
  name          String?   @map("name")
  email         String?   @unique @map("email")
  emailVerified DateTime? @map("emailVerified")
  image         String?   @map("image")
  password      String?   @map("password")
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now()) @map("createdAt")
  updatedAt     DateTime  @updatedAt @map("updatedAt")
  isAdmin       Boolean   @default(false) @map("isAdmin")
  twoFactorEnabled Boolean  @default(false) @map("twoFactorEnabled")

  @@map("User")
}

model verificationtokens {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum FootShape {
  egyptian
  roman
  greek
  germanic
  celtic
}
