
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Shoe {
  id                 String            @id @default(uuid())
  name               String
  brand              String
  imageUrl           String?
  aggressiveness     String
  stiffness          String
  climbingDiscipline String
  volume             String
  rubberTechnologyId String?
  comfortRankings    ComfortRanking[]
  footShapeCompat    FootShapeCompat[]
  rubberTechnology   RubberTechnology? @relation(fields: [rubberTechnologyId], references: [id])
  favoritedBy        User[]
  ownedBy            UserShoe[]
}

model RubberTechnology {
  id         String @id @default(uuid())
  brand      String
  compound   String
  stickiness String
  durability String
  shoes      Shoe[]

  @@unique([brand, compound])
}

model ComfortRanking {
  id        String    @id @default(uuid())
  shoeId    String
  footShape FootShape
  volume    String
  score     Int
  shoe      Shoe      @relation(fields: [shoeId], references: [id])
}

model FootShapeCompat {
  id        String    @id @default(uuid())
  shoeId    String
  footShape FootShape
  shoe      Shoe      @relation(fields: [shoeId], references: [id])
}

model Account {
  id           String    @id @default(cuid())
  accountId    String
  providerId   String
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken  String?
  refreshToken String?
  idToken      String?
  expiresAt    DateTime?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?

  @@map("account")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

enum FootShape {
  egyptian
  roman
  greek
  germanic
  celtic
}

model User {
  id              String     @id
  name            String
  email           String
  emailVerified   Boolean
  image           String?
  createdAt       DateTime
  updatedAt       DateTime
  isAdmin         Boolean?
  onboardingComplete Boolean @default(false)
  footShape       FootShape?
  favoriteShoeId  String?
  favoriteShoe    Shoe?      @relation(fields: [favoriteShoeId], references: [id])
  sessions        Session[]
  accounts        Account[]
  stash           UserShoe[]

  @@unique([email])
  @@map("user")
}

model UserShoe {
  id        String   @id @default(cuid())
  userId    String
  shoeId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shoe      Shoe     @relation(fields: [shoeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, shoeId])
  @@map("user_shoe")
}
