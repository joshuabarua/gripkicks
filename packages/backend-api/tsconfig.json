{
	"compilerOptions": {
		"target": "ES2020",
		"module": "NodeNext",
		"rootDir": ".",
		"outDir": "./dist",
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"moduleResolution": "NodeNext",
		"sourceMap": true,
		"declaration": true,
		"composite": true,
				"paths": {
			"@/*": ["./*"]
		},
		"types": ["node"]
	},
	"include": [
		"src/**/*",
		"routes/**/*",
		"controllers/**/*",
		"middleware/**/*",
		"config/**/*",
		"db/**/*",
		"lib/**/*",
		"utils/**/*",
		"services/**/*"
	],
	"exclude": ["node_modules", "**/*.spec.ts"]
}
